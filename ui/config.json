{
  "id": "org.your-pc-can-do.pdf-ocr",
  "name": "PDF·이미지 OCR",
  "description": "스캔 문서에서 글자와 QR 내용을 꺼내고 검색 가능한 PDF를 만듭니다.",
  "author": "marin6670",
  "networkDisclosure": {
    "summary": "문서를 로컬에서 처리하며 업로드하지 않습니다. OneOCR 엔진은 설치된 Windows 앱에서 확보합니다. RapidOCR 백업 모델이 없으면 모델 배포 서버에서 다운로드하며, 실행 환경 설치는 PyPI를 사용합니다.",
    "destinations": [
      "www.modelscope.cn",
      "*.modelscope.cn",
      "pypi.org",
      "files.pythonhosted.org"
    ]
  },
  "actions": [
    {
      "id": "text",
      "title": "텍스트 추출",
      "description": "",
      "accepts": [
        "pdf",
        "jpg",
        "jpeg",
        "png",
        "bmp",
        "tif",
        "tiff",
        "gif",
        "webp"
      ],
      "multiple": true,
      "inputRequired": true,
      "options": []
    },
    {
      "id": "searchable-pdf",
      "title": "검색 가능한 PDF 만들기",
      "description": "",
      "accepts": [
        "pdf",
        "jpg",
        "jpeg",
        "png",
        "bmp",
        "tif",
        "tiff",
        "gif",
        "webp"
      ],
      "multiple": true,
      "inputRequired": true,
      "options": []
    },
    {
      "id": "preview",
      "title": "페이지 미리보기",
      "description": "선택한 문서를 가로 미리보기로 준비합니다.",
      "accepts": [
        "pdf",
        "jpg",
        "jpeg",
        "png",
        "bmp",
        "tif",
        "tiff",
        "gif",
        "webp"
      ],
      "multiple": true,
      "inputRequired": true,
      "options": []
    },
    {
      "id": "save-text",
      "title": "편집본 저장",
      "description": "편집한 텍스트를 CanDo 결과 폴더에 새 파일로 저장합니다.",
      "accepts": [],
      "multiple": false,
      "inputRequired": false,
      "options": [
        {
          "key": "text",
          "type": "string",
          "label": "텍스트",
          "default": ""
        },
        {
          "key": "name",
          "type": "string",
          "label": "파일 이름",
          "default": "OCR"
        }
      ]
    }
  ],
  "locales": {
    "en": {
      "name": "PDF & image OCR",
      "description": "Extract text and QR content from scans, or create searchable PDFs.",
      "networkSummary": "Documents are processed locally and are not uploaded. OneOCR is obtained from an installed Windows app. Missing RapidOCR fallback models are downloaded from model distribution servers. Runtime installation uses PyPI.",
